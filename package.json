{
  "name": "skillbench-cli",
  "version": "0.4.0",
  "description": "Build, validate, evaluate, and distribute portable Agent Skills from a polished terminal UI.",
  "private": false,
  "author": "Aleksei Malikov",
  "homepage": "https://alexrett.github.io/skillbench/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexrett/skillbench.git"
  },
  "bugs": {
    "url": "https://github.com/alexrett/skillbench/issues"
  },
  "type": "module",
  "bin": {
    "skillbench": "dist/cli.js"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx new",
    "build": "bun build src/cli.tsx --target=bun --outdir=dist",
    "build:binary": "bun build src/cli.tsx --compile --outfile dist/skillbench",
    "build:release": "bun run scripts/build-release.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build",
    "site:check": "bun run scripts/check-site.ts",
    "site:serve": "bunx serve site --listen 4173",
    "prepack": "bun run check",
    "pack:check": "npm pack --dry-run"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "agent-skills",
    "codex",
    "cli",
    "tui",
    "evals"
  ],
  "license": "MIT",
  "dependencies": {
    "@semos-labs/glyph": "0.2.10",
    "react": "19.1.1",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@types/bun": "1.2.20",
    "@types/react": "19.1.10",
    "typescript": "5.9.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.14"
}
